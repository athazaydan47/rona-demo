# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.
DATABASE_URL=
DEMO_MODE=true
STUDIO_NAME=
STUDIO_URL=
# Rahasia untuk route cron kedaluwarsa (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Rahasia HMAC untuk webhook pembayaran (header x-rona-signature)
PAYMENT_WEBHOOK_SECRET=
# Hanya untuk uji Playwright: izinkan memajukan jam server lewat /api/demo/jam saat DEMO_MODE=true
ALLOW_CLOCK_OVERRIDE=
