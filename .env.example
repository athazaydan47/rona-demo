# Salin ke .env.local untuk lokal, atau isi di Vercel untuk produksi. Jangan commit nilai rahasia.
# Penjelasan lengkap tiap kunci ada di docs/DEPLOY.md.

# Database. Produksi (Neon): DATABASE_URL = connection string pooled, DATABASE_URL_UNPOOLED = direct.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Mode demo: tombol simulasi bayar, jam demo untuk uji, dan pembuatan slot flash sale otomatis.
DEMO_MODE=true

# Kredit pembuat di footer dan halaman Tentang Demo.
STUDIO_NAME=
STUDIO_URL=

# URL publik situs untuk tautan di notifikasi dan berbagi, misal https://rona-demo.vercel.app
NEXT_PUBLIC_SITE_URL=

# Rahasia route cron kedaluwarsa (Authorization: Bearer <CRON_SECRET>). Vercel Cron mengirimnya otomatis.
CRON_SECRET=

# Rahasia HMAC webhook pembayaran (header x-rona-signature).
PAYMENT_WEBHOOK_SECRET=

# Kata sandi akun staf demo saat seed (bawaan demo1234).
DEMO_STAFF_PASSWORD=

# Hanya untuk uji Playwright lokal. JANGAN diisi di produksi.
ALLOW_CLOCK_OVERRIDE=

# Hanya saat menjalankan db:reset atau db:seed ke database selain lokal: isi rona-demo untuk konfirmasi.
CONFIRM_RESET=
