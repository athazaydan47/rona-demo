# Salin ke .env.local untuk lokal, atau isi di Vercel untuk produksi. Jangan commit nilai rahasia.
# Penjelasan lengkap tiap kunci ada di docs/DEPLOY.md.

# Database. Produksi (Neon): DATABASE_URL = connection string pooled, DATABASE_URL_UNPOOLED = direct.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Mode demo: tombol simulasi bayar, jam demo untuk uji, dan pembuatan slot flash sale otomatis.
DEMO_MODE=true

# Kredit pembuat di footer dan halaman Tentang Demo. STUDIO_WA (opsional, Fase 8A): nomor WhatsApp studio dengan kode
# negara tanpa tanda plus, misal 6281234567890, untuk tombol "Ngobrol di WhatsApp" di /tentang-demo.
STUDIO_NAME=
STUDIO_URL=
STUDIO_WA=

# URL publik situs untuk tautan di notifikasi dan berbagi, misal https://rona-demo.vercel.app
NEXT_PUBLIC_SITE_URL=

# Rahasia route cron kedaluwarsa (Authorization: Bearer <CRON_SECRET>). Vercel Cron mengirimnya otomatis.
CRON_SECRET=

# Rahasia HMAC webhook pembayaran (header x-rona-signature).
PAYMENT_WEBHOOK_SECRET=

# Rahasia untuk HMAC kode OTP dan alamat IP di rate limit (pembeli dan staf). WAJIB di produksi, minimal 32 karakter acak
# (misal hasil: openssl rand -base64 36). Tanpa ini di Vercel, halaman masuk menampilkan "Masuk belum tersedia".
SESSION_SECRET=

# Token Vercel Blob untuk foto ulasan (opsional). Tanpa token di Vercel, unggah foto dinonaktifkan dengan pesan ramah;
# ulasan teks tetap bisa dikirim. Di lokal foto disimpan di folder .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Kata sandi akun staf demo saat seed (owner@, admin@, dinoyo@, gudang@rona.demo). Bawaan demo1234.
DEMO_STAFF_PASSWORD=

# Reset data demo tiap malam (03.00 WIB) lewat cron harian. Hanya berjalan bila DEMO_MODE=true juga.
DEMO_DAILY_RESET=

# Hanya untuk uji Playwright lokal. JANGAN diisi di produksi.
ALLOW_CLOCK_OVERRIDE=

# Adapter email (Fase 6C): preview (bawaan, tidak mengirim apa pun) atau resend.
EMAIL_PROVIDER=preview
# Hanya bila EMAIL_PROVIDER=resend. Domain pengirim wajib terverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Saat DEMO_MODE=true email sungguhan hanya ke alamat ini (pisahkan dengan koma); alamat lain ditandai Dilewati.
EMAIL_ALLOWLIST=

# AI (Fase 7A, 7B, dan 7C): Gemini lewat Cloudflare AI Gateway. Asisten Admin, Kabar Harian, penulis deskripsi, dan draf
# balasan ulasan (Fase 7B) memakai env yang sama; tanpa env ini Kabar Harian tetap dibuat dengan narasi templat. Kosongkan untuk mematikan fitur AI; kuis, rutinitas, padanan
# shade, dan pencarian biasa tetap jalan. Format URL: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/google-ai-studio
AI_GATEWAY_URL=
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
# Wajib bila gateway memakai Authenticated Gateway (dikirim sebagai header cf-aig-authorization).
CF_AIG_TOKEN=
# Tingkat berpikir Gemini (minimal, low, medium, high). Kosongkan: otomatis yang terendah yang didukung model
# (minimal; low untuk Gemini 3.8 Flash). Lebih tinggi berarti lebih banyak token keluar dan lebih lambat.
AI_THINKING_LEVEL=
# Batas panggilan AI per hari (WIB, semua fitur). Bila tercapai, fitur AI tampil "sedang istirahat".
AI_DAILY_CAP=1000
# Foto kuis dan cari dupe dari video (Fase 7C) memakai env AI yang sama. Batas per pengunjung per hari: 5 foto dan
# 10 permintaan dupe, plus AI_DAILY_CAP.
# Hanya uji, Playwright, dan cuplik: isi mock untuk jawaban deterministik tanpa memanggil API. Jangan di produksi.
AI_PROVIDER=

# Darurat saja: isi true untuk melewati migrasi otomatis di build produksi Vercel. Biarkan kosong.
SKIP_BUILD_MIGRATION=

# Hanya saat menjalankan db:reset atau db:seed ke database selain lokal: isi rona-demo untuk konfirmasi.
CONFIRM_RESET=
